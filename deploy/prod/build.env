# Build-аргументы образа приложения СТО для окружения «prod».
# Всё здесь ПУБЛИЧНОЕ: NEXT_PUBLIC_* запекаются в клиентский JS и уходят в
# браузер каждому, кто открыл приложение; anon-ключ Supabase публичен по
# определению. Секреты (токен GitHub Packages, сервисный ключ,
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY) сюда НЕ пишутся — они в секрете сборки
# и в /data/abkhaz-rabota/.env.production на сервере.
#
# Значения обязаны совпадать с боевым сайтом (abkhaz-auto, deploy/prod/build.env):
# приложение живёт на поддомене и читает ТУ ЖЕ куку сессии, что выдаёт сайт.
NEXT_PUBLIC_SUPABASE_URL=https://sb.abkhaz-auto.ru

# Домен куки сессии. Критично: кука aa-auth-token выдаётся сайтом на
# .abkhaz-auto.ru, и браузер пришлёт её на rabota.abkhaz-auto.ru только при этом
# значении. Разъедется — приложение будет видеть гостя при живой сессии сайта.
NEXT_PUBLIC_COOKIE_DOMAIN=.abkhaz-auto.ru

# Куда отправлять за входом («Войти на сайте») — канонический хост сайта.
NEXT_PUBLIC_SITE_URL=https://abkhaz-auto.ru

# Anon-ключ боевого Supabase — тот же, что в abkhaz-auto/deploy/prod/build.env.
# Публичен по определению: уходит в браузер в клиентском бандле сайта.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzc4Nzc5MjAxLCJleHAiOjIwOTQxMzkyMDF9.UL_GvF44H6uy4v7tIfuorqHq8e2a3KyOwTiHXJPwLjo
