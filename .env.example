# Тот же проект Supabase, что у сайта: приложение читает общую базу.
NEXT_PUBLIC_SUPABASE_URL=https://sb.abkhaz-auto.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Сервисный ключ — только на сервере приложения: чтение витрин и записей
# своего сервиса идёт под ним после проверки владения (см. src/lib/shop.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Внутренний адрес Supabase из docker-сети (на проде), пусто — публичный.
SUPABASE_INTERNAL_URL=
# Домен куки сессии — ТОТ ЖЕ, что у сайта (.abkhaz-auto.ru): вход делается на
# сайте, кука общая для поддоменов. Локально пусто и куку не разделить —
# см. README, «Вход в разработке».
NEXT_PUBLIC_COOKIE_DOMAIN=
# Адрес сайта: ссылка на вход и внутренний API /api/sto/* (#1272).
NEXT_PUBLIC_SITE_URL=https://abkhaz-auto.ru
SITE_INTERNAL_URL=
# Подпись запросов к сайту (@zebrooo/service-ticket, как у promo-bff).
STO_TICKET_PRIVATE_KEY=
STO_TICKET_SRC=abkhaz-sto
STO_TICKET_DST=abkhaz-auto
# Стабильный ключ шифрования Server Actions — иначе каждый билд ломает
# открытые вкладки («Server Action not found»).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
